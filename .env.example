# Copiar a .env y completar. NUNCA subir .env al repositorio.
OPENAI_API_KEY=your_openai_api_key_here

# Modelos
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Base de datos (localhost:5433 si ejecutas en host; docker-compose sobreescribe esto a db:5432)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.35
MAX_UPLOAD_MB=20

# Concurrencia / resiliencia
LLM_MAX_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=30
